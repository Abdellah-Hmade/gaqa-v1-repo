# ===========================================================================
# GAQA v1 reproduction — configuration
# ---------------------------------------------------------------------------
# Every value can be changed here. Variables named in this file are read by
# config.py at import time; command-line flags (e.g. --batch-size) override
# them. No secrets here, so this file is safe to commit — if you prefer, add
# it to .gitignore and keep .env.example as the template.
# ===========================================================================

# --- test mode (scripts/test.sh) ---------------------------------------------
# smoke = fast, no GPU, no 2B download (default). full = venv -> data ->
# real-model evaluation (needs ~16 GB GPU or patience on CPU).
TEST_MODE=smoke

# --- data source (train.py / eval.py / benchmark.py) --------------------------
# zenodo : auto-download the released dataset from Zenodo (default)
# local  : read the released gaqa_v1_*.jsonl from GAQA_DATA_DIR
# rebuild: use the dataset built by data_pipeline (scripts/rebuild_data.sh)
DATA_SOURCE=zenodo

# --- dataset ----------------------------------------------------------------
# Zenodo record id of the GAQA v1 dataset release.
ZENODO_RECORD=21762025

# Optional: local directory containing the gaqa_v1_*.jsonl files (used when
# DATA_SOURCE=local). Leave empty otherwise.
GAQA_DATA_DIR=

# Rebuilt-dataset locations (used when DATA_SOURCE=rebuild).
REBUILD_DATA_DIR=data_pipeline/data/processed_gaqa_v3
REBUILD_HELDOUT_DIR=data_pipeline/data/realval_v3_heldout
REBUILD_KNOWLEDGE_DIR=data_pipeline/data/gaqa_knowledge

# --- models (Hugging Face) --------------------------------------------------
BITNET_MODEL=microsoft/bitnet-b1.58-2B-4T
MISTRAL_MODEL=mistralai/Mistral-7B-Instruct-v0.3
QWEN_MODEL=Qwen/Qwen2.5-7B-Instruct

# Hugging Face access token (required only for gated models, e.g. Mistral).
HF_TOKEN=

# --- fine-tuning protocol (paper values) ------------------------------------
SEED=42
LORA_R=32
LORA_ALPHA=64
LORA_DROPOUT=0.05
NUM_EPOCHS=3
BATCH_SIZE=8
GRAD_ACCUM=1
MAX_LENGTH=1024
LEARNING_RATE=0.0002
WARMUP_RATIO=0.05
WEIGHT_DECAY=0.01
GRAD_CLIP=1.0

# 0 = use all / run full epochs. Set MAX_TRAIN_SAMPLES / MAX_STEPS for quick
# sanity runs on small GPUs.
MAX_TRAIN_SAMPLES=0
MAX_STEPS=0
EVAL_SAMPLES=256

# --- evaluation / benchmark --------------------------------------------------
EVAL_BATCH_SIZE=16
DEVICE=cuda

# --- outputs -----------------------------------------------------------------
OUTPUT_DIR=outputs/gaqa-v1-lora
BENCHMARK_OUTPUT=outputs/multi_model_comparison.csv

# --- data creation pipeline (data_pipeline/) --------------------------------
# Directory where raw reads / assemblies / QC outputs live.
REALVAL_DATA_DIR=data/realval
# Parallel assembly jobs.
REALVAL_JOBS=12
# vLLM OpenAI-compatible endpoint for knowledge question generation.
KNOWLEDGE_ENDPOINT=http://localhost:8000/v1
# Jittered copies per real metric vector (paper: 60).
JITTER_COPIES=60