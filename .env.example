BITNET_MODEL=microsoft/bitnet-b1.58-2B-4T-bf16
DATA_PROCESSED_DIR=./data/processed
MAX_TRAIN_SAMPLES=30000
MAX_EVAL_SAMPLES=2000
MAX_LENGTH=1024
BATCH_SIZE=8
GRAD_ACCUM=1
WARMUP_RATIO=0.1
SCHEDULER=cosine
GRADIENT_CHECKPOINTING=false
DATALOADER_NUM_WORKERS=4
LORA_TARGET_MODULES=q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj
BITNET_PACKED_ADAPTER_DIR=./models/bitnet-packed-adapter
BITNET_STE_ADAPTER_DIR=./models/bitnet-ste-adapter
BITNET_LORA_R=8
BITNET_LORA_ALPHA=16
BITNET_LORA_DROPOUT=0.05
BITNET_LEARNING_RATE=2e-4
BITNET_NUM_EPOCHS=3
BITNET_OPTIMIZER=adamw_torch
LOG_DIR=./logs
EVAL_NUM_SAMPLES=2000
EVAL_BATCH_SIZE=4
EVAL_MAX_NEW_TOKENS=10
NTFY_TOPIC=gaqa-reference
OUTPUT_DIR=./results
PROJECT_NAME=gaqa-bitnet-assembly
SEED=42
